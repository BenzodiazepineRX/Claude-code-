 "bg_telephone": {
  "hp_hz": 600.0,
  "lp_hz": 2000.0,
  "type": "Butterworth 2nd order each, applied forward-backward (zero phase) -> 24 dB/oct, -6 dB at the corners",
  "why": {
   "hp": "Gate 1 harmonic envelope: box hump 430-530 Hz (peak 474-480). 600 Hz zero-phase HP puts 480 Hz at about -10.7 dB on the layer, so the copy adds no box (anti-tunnel)",
   "lp": "Gate 1 masking scan: the beat covers the lead most at 2.0-3.2 kHz (beat over vocal +2.7..+4.0 dB) and the lead presence bell is at 2.8 kHz, so the layer rolls off from 2.0 kHz (2.5 kHz -8.6 dB, 3.2 kHz -16 dB) and leaves the lead words that range",
   "zero_phase": "a causal band-pass would delay the copy by its group delay (~10-20 samples) = comb with the lead; filtfilt keeps it at 0 samples (verified by xcorr). Gentle 2nd-order sections keep pre-ringing small; checked as the layer is 15-20 dB under the lead",
   "band_center_hz": 1095.0
  }
 },
 "bg_ducker": {
  "depth_db": 3.0,
  "attack_ms": 10.0,
  "release_ms": 111.111,
  "key": "all dry vocals, 1-4 kHz, depth = 3 dB * clip((env - (p95-20 dB))/10 dB,0,1)",
  "why": "Kenshin: dip the layer whenever the lead is active. LEARNINGS echo rule 8: duck lightly and fast (3-4 dB, release 80-120 ms); release = 1/16 note (111.1 ms). Capped at 3 dB because ATL showed riding a BG stem lifted tails/breaths ~12 dB (a ducker lifts tails relative to words by at most its depth)"
 },
 "bg_levels_target_db_under_lead_1to4k": {
